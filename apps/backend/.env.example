# Copy to .env; replace placeholders with local-only values. No real bank secrets.
ENVIRONMENT=development
LOG_LEVEL=INFO
CEDAR_DATABASE_URL=postgresql+psycopg://cedar_runtime:REPLACE_CEDAR_PASSWORD@127.0.0.1:5433/veriq_cedar
VERIQ_DATABASE_URL=postgresql+psycopg://veriq_runtime:REPLACE_VERIQ_PASSWORD@127.0.0.1:5433/veriq_cedar
SIMULATOR_DATABASE_URL=postgresql+psycopg://simulator_runtime:REPLACE_SIMULATOR_PASSWORD@127.0.0.1:5433/veriq_cedar
# Only Alembic reads this credential; runtime Settings does not contain it.
MIGRATION_DATABASE_URL=postgresql+psycopg://veriq_cedar_migrator:REPLACE_MIGRATION_PASSWORD@127.0.0.1:5433/veriq_cedar
DB_CONNECT_TIMEOUT_SECONDS=2
DB_STATEMENT_TIMEOUT_MS=3000
DB_POOL_SIZE=5
DB_POOL_TIMEOUT_SECONDS=2
