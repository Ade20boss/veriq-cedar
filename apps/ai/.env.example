# Share this internal secret ONLY with Daniel's backend. Do not commit the real .env.
INTERNAL_SERVICE_KEY=replace-with-a-long-random-service-secret
# Defaults to labelled deterministic mock responses. No provider key required.
LLM_PROVIDER=mock
# To use Groq or another OpenAI-compatible API: LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# Set false if your model does not support response_format=json_object.
LLM_JSON_MODE=true
